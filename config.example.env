# 复制本文件为 translate.env，并填写真实值。
# translate.env 已在 .gitignore 中，不会被提交到 GitHub；请勿把真实密钥写进本模板。

# ===== 数据库（路径、文件名属于敏感信息；表名可公开）=====
# Access 数据库文件的路径，建议使用相对于本目录的路径
BLOG_DB=./your-private-blog.mdb
SOURCE_TABLE=blog_Article
TARGET_TABLE=blog_Article_Trans
PROGRESS_TABLE=blog_Article_Trans_Progress
ACCESS_ODBC_DRIVER=Microsoft Access Driver (*.mdb, *.accdb)

# ===== 翻译引擎与模型 =====
# 可选：qwen-mt-lite / qwen-mt-plus / doubao-seed-translation / deepseek
TRANSLATE_ENGINE=deepseek

# DeepSeek 官方 API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_DISABLE_THINKING=0

# 火山方舟（DeepSeek / Doubao-Seed 通用模型，以及豆包翻译专用模型共用）
ARK_API_KEY=
DOUBAO_MODEL=doubao-seed-translation-250915
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 阿里云百炼 Qwen-MT
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 可选：自定义术语表 JSON 文件路径，留空则使用代码内置术语 =====
GLOSSARY_FILE=

# 检查脚本 _inspect.py 查询进度表时使用的引擎名
INSPECT_ENGINE=
